{:paths ["." "gen"]
 :deps {org.babashka/http-client {:mvn/version "0.4.23"}
        org.babashka/json {:mvn/version "0.1.6"}
        hiccup/hiccup {:mvn/version "2.0.0-RC3"}
        ;; Tyrell icon SVGs as Clojure defs (tyrell.lucide etc.)
        dev.gersak/tyrell-icons {:mvn/version "1.0.0-RC6"}
        ;; the babashka SDK we've been building this session
        synthigy/client {:local/root "../../.."}}
 :tasks {serve {:doc "Run the chat BFF on :8095" :task (load-file "main.clj")}
         gen   {:doc "Regenerate gen/ from synthigy/*.xsql (needs a running backend)"
                :task (exec 'synthigy.gen/generate)
                :exec-args {:dir "synthigy" :out "gen" :ns-prefix "chat.ops"}}
         gen-check {:doc "CI gate: verify gen/ matches synthigy/*.xsql (needs a running backend)"
                    :task (exec 'synthigy.gen/check)
                    :exec-args {:dir "synthigy" :out "gen" :ns-prefix "chat.ops"}}}}
