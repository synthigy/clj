@workspace "Chat Rooms"

@search list
@description "All chat messages the acting user can see (RLS-scoped via acting_as)."
@namespace message
@watch
chato_message
  content
  published_on

@search memberships
@description "Message-to-group links for the given groups, read from the User
Group side (the m2m link is not projectable from the message side)."
@namespace group
user_group (xid in (?xids:string[]))
  ->messages
    xid

@batch bootstrap: list memberships
