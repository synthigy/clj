{:paths ["src"]

 :deps
 {org.clojure/clojure {:mvn/version "1.12.0"}
  org.clojure/core.async {:mvn/version "1.8.741"} ; mux fan-out + debounce (bb has it built-in)
  org.babashka/http-client {:mvn/version "0.4.23"}
  org.babashka/json {:mvn/version "0.1.6"}
  org.clojure/data.json {:mvn/version "2.5.0"} ; gen writes schema.json indented; babashka.json can't
  funcool/promesa {:mvn/version "11.0.678"} ; cljs client verbs (Promise-returning)
  cljs-bean/cljs-bean {:mvn/version "1.9.0"} ; cljs JS<->CLJS interop (->js/->clj, lazy)
  com.cognitect/transit-cljs {:mvn/version "0.8.280"} ; /data wire codec (dates as real js/Date)
  com.cognitect/transit-clj {:mvn/version "1.0.333"}} ; /data wire codec on JVM (bb has it built-in)

 :aliases
 {:gen
  {:exec-fn synthigy.gen/generate}

  :gen-check
  {:exec-fn synthigy.gen/check}

  :build
  {:extra-paths ["."]
   :deps {io.github.clojure/tools.build {:mvn/version "0.10.9"}
          slipset/deps-deploy {:mvn/version "0.2.2"}}
   :ns-default build}

  :dev
  {:extra-paths ["test" "examples/browser-demo/src"]
   :extra-deps {nrepl/nrepl {:mvn/version "1.3.0"}
                thheller/shadow-cljs {:mvn/version "2.28.21"}}}

  :test
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts ["-m" "cognitect.test-runner" "-r" "synthigy.(client.(key|selection|compose|filter|subscriptions|watch|query|ops|verbs|auth-supervised)|gen)-test"]
   :exec-fn cognitect.test-runner.api/test}

  :integration
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts ["-m" "cognitect.test-runner" "-n" "synthigy.client.integration-test"]
   :exec-fn cognitect.test-runner.api/test}

  :onboard-integration
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts ["-m" "cognitect.test-runner" "-n" "synthigy.client.onboard-integration-test"]
   :exec-fn cognitect.test-runner.api/test}}}
